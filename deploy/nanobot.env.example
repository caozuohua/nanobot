# Example environment file for the vps-lite systemd install.
# Copy this to /etc/nanobot/nanobot.env, keep it root:nanobot 0640, and fill in your values.
#
# Google service account JSON path:
# - Point GOOGLE_APPLICATION_CREDENTIALS at the JSON file on disk.
# - Keep the JSON outside the repository and readable only by root/nanobot.

GOOGLE_CLOUD_PROJECT=your-vertex-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/etc/nanobot/google-service-account.json

# Provider API keys for the vps-lite profile.
GEMINI_API_KEY=replace-me
OPENAI_API_KEY=replace-me

# Chat channel credentials.
LARK_APP_ID=replace-me
LARK_APP_SECRET=replace-me
TELEGRAM_TOKEN=replace-me
DISCORD_TOKEN=replace-me
