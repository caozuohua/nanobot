# Example environment file for nanobot minimal deployment
# Copy to /etc/nanobot/nanobot.env and edit values. Keep file permissions restricted (root:nanobot 640).

# GCP Vertex credentials (service account JSON path)
GOOGLE_APPLICATION_CREDENTIALS=/etc/nanobot/sa.json

# Vertex settings
VERTEX_PROJECT_ID=your-project-id
VERTEX_LOCATION=us-central1
# Choose one of: gemini-2.5-pro, gemini-2.5-flash, gemini-2.5-flash-lite
VERTEX_GEN_MODEL=gemini-2.5-flash
VERTEX_EMB_MODEL=textembedding-gecko@001

# Lark WebSocket URL
LARK_WS_URL=wss://your-lark-ws-url

# Local storage
SQLITE_PATH=/var/lib/nanobot/nanobot_memory_minimal.db
FILES_DIR=/var/lib/nanobot/files

# Worker concurrency (set 1 on low-RAM VPS)
WORKER_CONCURRENCY=1
