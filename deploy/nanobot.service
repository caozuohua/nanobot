[Unit]
Description=nanobot vps-lite gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nanobot
Group=nanobot
WorkingDirectory=/opt/nanobot
EnvironmentFile=-/etc/nanobot/nanobot.env
Environment=NANOBOT_PROFILE=vps-lite
ExecStart=/opt/nanobot/.venv/bin/nanobot gateway --profile vps-lite --config /etc/nanobot/config.json --workspace /var/lib/nanobot/workspace
Restart=on-failure
RestartSec=5s
MemoryHigh=550M
MemoryMax=700M
TasksMax=128
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000
NoNewPrivileges=no
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallArchitectures=native
AmbientCapabilities=
ReadWritePaths=/var/lib/nanobot /etc/nanobot /var/www/blog /opt/workspace

[Install]
WantedBy=multi-user.target
